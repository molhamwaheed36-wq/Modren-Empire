[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[application]
config/name="Modren Empire"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[input]
ui_accept={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventMouseButton,"button_index":1)]}

[autoload]
Game="*res://systems/Game.gd"
Economy="*res://systems/Economy.gd"
Network="*res://systems/Network.gd"
SaveSystem="*res://systems/SaveSystem.gd"
Director="*res://systems/Director.gd"
BankAdapter="*res://systems/BankAdapter.gd"
